
alias LEVEL_COUNT 12;
alias userIdType uint64;


struct EVENT_PLAYER_JOIN {
    userId : userIdType
    userName : string
    dinoSkinId : uint8
}


struct EVENT_PLAYER_LEAVE {
    userId : userIdType
}


/* 
This is a multiline
comment which can
span multiple lines 
*/

struct ENTITY_DINO {
    is_host : bool
    id :   uint64
    x: float32
    y: float32
    vspd: float32
    hspd :   float32
    stateId: uint8
}

struct Vector {
    x @0: float32
    y @1: float32
    z @2: float32
}

// Single line comments
struct ENTITY_COIN @453 {
    id : uint64 
    x  : float32
    y  : float32
    vspd :           float32
    hspd : float32
    stateId : uint8
    lookVector : {
        x: float32
        y: float32
        z: float32 
    }
    health : {
        hunger :uint8,
        thirst: uint8,
        sleep : uint8
    }
    anotherVector :  Vector    
}

struct DATA_SAVE_GAME @0x34fa {
    levelData: Vector[LEVEL_COUNT]
    playTime: uint32[3] // fixed size array 
    levelScore : uint16[] // dynamically sized array (vector)
}

union Event <EVENT_PLAYER_JOIN, EVENT_PLAYER_LEAVE>
union Entity <ENTITY_DINO, ENTITY_COIN>